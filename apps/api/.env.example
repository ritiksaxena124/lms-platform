# Copy to .env (dev) or .env.test (tests). Never commit real values.

NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://teacher.localtest.me:3000,http://student.localtest.me:3001,http://ops.localtest.me:3002

# Public base URL of this API. Nothing a reader sees is built from it: the boot line announces
# itself, uploads stream through a route that checked who is asking, and a notification links to a
# portal instead — the three keys below are what points a person at something they can open.
API_PUBLIC_URL=http://api.localtest.me:4000

# Where each portal is served. A notification's button is one of these origins plus a page inside it,
# and both are required: a message that linked to the API's own address would open a JSON error in
# front of somebody expecting their class list, and a `localhost` default would boot happily and then
# send links nobody off this machine can open (ARCHITECTURE §6).
TEACHER_PORTAL_URL=http://teacher.localtest.me:3000
STUDENT_PORTAL_URL=http://student.localtest.me:3001

DATABASE_URL=postgresql://lms:CHANGE_ME@localhost:5432/lms?schema=public

# Required in every environment — access tokens cannot be signed without it, and a
# per-process fallback would silently log everyone out on the next restart.
# Generated with: openssl rand -hex 32
JWT_SECRET=
REFRESH_TOKEN_TTL_DAYS=7

# Set so one login covers every portal on *.localtest.me. Leave unset for a host-only
# cookie (the right answer in production when the API sits on its own domain).
COOKIE_DOMAIN=localtest.me
# Defaults to true under NODE_ENV=production. Set explicitly when TLS ends at a proxy.
COOKIE_SECURE=false

# Storage provider for course files: local | s3. Uploaded bytes have no public URL by design —
# a route that has already checked who is asking streams them (ARCHITECTURE §6).
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage/uploads
MAX_UPLOAD_MB=15

# Email transport. Empty SMTP_URL means this box sends no mail: notifications are dropped, the drop
# is logged by its event code, and no address or subject is ever logged with it. When SMTP_URL is
# set it must be an smtp:// or smtps:// endpoint and MAIL_FROM is required with it — a deployment
# with half of a mail config stops at boot rather than sending from whatever the login implies
# (ARCHITECTURE §6).
SMTP_URL=
MAIL_FROM="Hourloom <no-reply@localtest.me>"

# Live classes: none | jitsi. `none` switches live classes off rather than breaking them — an
# uploaded lesson still plays, because that is the storage provider above (ARCHITECTURE §10).
# JITSI_DOMAIN is a bare host, no scheme and no path: the public bridge by default, a self-hosted
# one when you have it. There is no JWT in front of a Jitsi room, so the name the API mints is
# the only thing keeping a class private — a room URL is a secret with a URL's shape, and it
# belongs to the two accounts a gate has already accepted and nowhere else (not a log line, not
# a course page).
VIDEO_PROVIDER=jitsi
JITSI_DOMAIN=meet.jit.si

# Payments are on hold until Phase 9: the adapter stays behind its port until a free provider is
# approved, so `none` is a value deployments actually run on.
PAYMENT_PROVIDER=none
