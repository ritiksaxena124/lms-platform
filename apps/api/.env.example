# Copy to .env (dev) or .env.test (tests). Never commit real values.

NODE_ENV=development
PORT=4000

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://student.localtest.me:3001,http://teacher.localtest.me:3002,http://ops.localtest.me:3003,http://api.localtest.me:4000

# Public base URL of this API, used in emails and provider callbacks.
API_PUBLIC_URL=http://api.localtest.me:4000

DATABASE_URL=postgresql://lms:CHANGE_ME@localhost:5432/lms?schema=public

# Generated with: openssl rand -hex 32
JWT_SECRET=
REFRESH_TOKEN_TTL_DAYS=7

# Storage provider for course files: local | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage/uploads
STORAGE_PUBLIC_URL=http://api.localtest.me:4000/files
MAX_UPLOAD_MB=15

# Email transport. Empty SMTP_URL logs emails to stdout in development.
SMTP_URL=
MAIL_FROM="LMS <no-reply@localtest.me>"

# Video + payments are on hold (free-tier providers under evaluation).
# Adapters stay behind ports; no vendor SDK is imported until approved.
VIDEO_PROVIDER=none
PAYMENT_PROVIDER=none
