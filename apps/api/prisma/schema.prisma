// Prisma is the only source of truth for the schema. Every change goes through a
// migration; `prisma migrate deploy` runs on the server, never `db push`.
//
// Conventions for every table added from here on:
//   id uuid default gen_random_uuid(), created_at/updated_at timestamptz,
//   is_active boolean default true, snake_case @map names, onDelete: Restrict
//   (rows are soft-deactivated, never deleted or cascaded away).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Configurable business constants. Statuses, roles and types live here rather than in
/// TypeScript enums, so Ops can add or retire a value without a code change.
model LkpType {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @map("code")
  description String?  @map("description")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  values LkpValue[]

  @@unique([code], map: "uk_lkp_type_code")
  @@map("lkp_type")
}

model LkpValue {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  typeId   String  @map("type_id") @db.Uuid
  code     String  @map("code")
  label    String  @map("label")
  position Int     @default(0) @map("position")
  isActive Boolean @default(true) @map("is_active")

  /// Identity-style reference rows stay reserved once used: deactivating a status must
  /// not free its code for a different meaning, because existing rows still point at it.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  type LkpType @relation(fields: [typeId], references: [id], onDelete: Restrict)

  /// Reverse relations for the two ways a user points at a reference row.
  usersAsRole   User[] @relation("user_role")
  usersAsStatus User[] @relation("user_status")

  /// Profiles that offer this subject, once `Subject` rows exist.
  teacherSubjects TeacherSubject[] @relation("subject_profile")

  /// Courses at this level, and courses in this stage of their life.
  coursesAsLevel  Course[] @relation("course_level")
  coursesAsStatus Course[] @relation("course_status")

  /// Lessons in their own stage of being written.
  lessonsAsStatus Lesson[] @relation("lesson_status")

  @@unique([typeId, code], map: "uk_lkp_value_type_code")
  @@index([typeId, isActive, position], map: "ix_lkp_value_type_active")
  @@map("lkp_value")
}

/// Anyone who can sign in to one of the three portals. The role is a lookup row, not a
/// column of allowed strings, so Ops can retire a role without a migration.
model User {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Stored lower-case by the service that writes it. Unique forever: deactivating an
  /// account must not recycle its address, or a new owner would inherit the old one's
  /// bookings, payouts and reviews.
  email           String    @unique @map("email")
  passwordHash    String    @map("password_hash")
  fullName        String    @map("full_name")
  /// IANA zone the user works in ("Asia/Kolkata"), never a fixed UTC offset — a DST change
  /// has to move the instant, which is what "same class time" means to a teacher.
  timezone        String    @default("UTC") @map("timezone")
  roleValueId     String    @map("role_value_id") @db.Uuid
  statusValueId   String    @map("status_value_id") @db.Uuid
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(6)

  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  role          LkpValue        @relation("user_role", fields: [roleValueId], references: [id], onDelete: Restrict)
  status        LkpValue        @relation("user_status", fields: [statusValueId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]
  profile       TeacherProfile?
  courses       Course[]        @relation("course_teacher")

  @@index([roleValueId, isActive], map: "ix_user_role_active")
  @@map("users")
}

/// What a student sees before they book: the teacher's own description of their work.
/// One row per teacher, written by the first save rather than at registration, so signing
/// up never leaves an empty profile that looks like a filled one.
///
/// The working timezone is deliberately absent — it lives on `User`, because a teacher's
/// zone decides when their classes are, not only what their profile says.
model TeacherProfile {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  /// One line in a search result. Kept short by validation so the card does not wrap.
  headline String? @map("headline")
  bio      String? @map("bio")

  /// Minor units plus an ISO 4217 code, never a float, and never a formatted string —
  /// "₹1,200" is unrenderable in a currency the reader does not share.
  /// Nullable as a pair: a teacher who has not decided yet should not be forced to
  /// publish a number they will not honour.
  hourlyRateMinorUnits Int?    @map("hourly_rate_minor_units")
  currencyCode         String? @map("currency_code") @db.VarChar(3)

  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  subjects TeacherSubject[]

  @@map("teacher_profile")
}

/// Which subjects a profile offers. A join row rather than an array column, because a
/// subject is a lookup value students will search and filter by, and a text array cannot
/// be indexed against a `lkp_value` that Ops may retire.
///
/// Removing a subject deactivates the row and re-adding it revives the same one — which is
/// what makes the unique key below safe alongside the no-hard-delete rule.
model TeacherSubject {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId      String @map("profile_id") @db.Uuid
  subjectValueId String @map("subject_value_id") @db.Uuid

  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile TeacherProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  subject LkpValue       @relation("subject_profile", fields: [subjectValueId], references: [id], onDelete: Restrict)

  @@unique([profileId, subjectValueId], map: "uk_teacher_subject")
  @@index([subjectValueId, isActive], map: "ix_teacher_subject_subject")
  @@map("teacher_subject")
}

/// A course a teacher is writing, has written, or has retired. Owned by exactly one
/// account: a co-author model would need a second table and the permissions question that
/// comes with it, and a marketplace where a course can change hands underneath a student
/// is a course nobody can be accountable for.
model Course {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherUserId String @map("teacher_user_id") @db.Uuid

  title String @map("title")
  /// The address a student is sent to. Unique per teacher rather than globally, because
  /// "intro-to-algebra" is a phrase two teachers will both reach for, and a global key
  /// hands the second one a fight over a word.
  ///
  /// Reserved for the teacher who used it first, even after the course is archived: an
  /// old link has to keep resolving to the thing it described.
  slug  String @map("slug")

  /// One line under a card title. Nullable, because a draft with no summary is still a
  /// draft worth keeping — but publishing is refused until it has one.
  summary     String? @map("summary")
  description String? @map("description")

  /// Level and status are lookup rows, so Ops can add a tier or retire a state without a
  /// migration; the transitions between statuses are enforced in code, which is the only
  /// place the difference between "archived" and "published" is meaningful.
  levelValueId  String @map("level_value_id") @db.Uuid
  statusValueId String @map("status_value_id") @db.Uuid

  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  teacher User     @relation("course_teacher", fields: [teacherUserId], references: [id], onDelete: Restrict)
  level   LkpValue @relation("course_level", fields: [levelValueId], references: [id], onDelete: Restrict)
  status  LkpValue @relation("course_status", fields: [statusValueId], references: [id], onDelete: Restrict)

  /// The syllabus, in the order the teacher put it in.
  modules Module[] @relation("course_modules")

  @@unique([teacherUserId, slug], map: "uk_course_teacher_slug")
  @@index([teacherUserId, isActive, createdAt], map: "ix_course_teacher_created")
  @@map("course")
}

/// One ordered block of a course's syllabus — the level a lesson sits under.
///
/// A module has no status of its own: the course's lifecycle is what decides whether a
/// student can read this row, and a second flag would need rules for which one wins.
model Module {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId String @map("course_id") @db.Uuid

  title       String  @map("title")
  summary     String? @map("summary")
  description String? @map("description")

  /// The slot inside the course, assigned by the service and never by a client. Gaps are
  /// normal and kept: a retired module still holds its number, so nothing can slide into a
  /// slot a student's note, screenshot or bookmark once named.
  position Int @map("position")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  course Course @relation("course_modules", fields: [courseId], references: [id], onDelete: Restrict)

  /// The lessons inside this block, in the order the teacher put them in.
  lessons Lesson[] @relation("module_lessons")

  @@unique([courseId, position], map: "uk_module_course_position")
  @@index([courseId, isActive, position], map: "ix_module_course_order")
  @@map("module")
}

/// One page of a module: what a teacher wrote, in the order it is taught.
///
/// Unlike a module, a lesson does carry its own status — a teacher writes a page over
/// several sittings, and a half-written one should not reach a student just because the
/// course around it is live. Both flags have to agree before a lesson is readable: the
/// course is the outer gate, the lesson the inner one, so neither exposes the other's
/// unfinished work.
model Lesson {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId String @map("module_id") @db.Uuid

  title String  @map("title")
  /// The page itself, as the teacher typed it. Nullable for the same reason a course's
  /// description is: naming a lesson is a planning act, and the writing can come after.
  body  String? @map("body")

  /// What the teacher thinks the page costs a student, shown but never enforced — it is an
  /// estimate, and an estimate a scheduling rule depended on would be a promise nobody made.
  estimatedMinutes Int? @map("estimated_minutes")

  /// The teacher's own "read this one without enrolling". It is a flag on one row and it
  /// opens nothing by itself: the catalog still requires the course to be published and this
  /// lesson to be published, so marking a draft free is a plan, not a leak. Default false
  /// because the alternative would publish every lesson ever written the moment it shipped.
  isFreePreview Boolean @default(false) @map("is_free_preview")

  /// The slot inside the module, assigned by the service and never by a client. Gaps are
  /// normal and kept: a retired lesson still holds its number, so nothing can slide into a
  /// slot a student's note or bookmark once named.
  position Int @map("position")

  /// A lookup row, so Ops can retire a stage without a migration; the transitions between
  /// them are enforced in code, which is the only place the difference is meaningful.
  statusValueId String @map("status_value_id") @db.Uuid

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  module Module   @relation("module_lessons", fields: [moduleId], references: [id], onDelete: Restrict)
  status LkpValue @relation("lesson_status", fields: [statusValueId], references: [id], onDelete: Restrict)

  @@unique([moduleId, position], map: "uk_lesson_module_position")
  @@index([moduleId, isActive, position], map: "ix_lesson_module_order")
  @@map("lesson")
}

/// One issued refresh session. The plaintext token never reaches the database — only its
/// digest — so a leaked table cannot be used to mint sessions.
model RefreshToken {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Revocation is a business transition with a date, distinct from `isActive`, which
  /// means "this row is archived". Rotation writes a new row rather than editing this one.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent String?   @map("user_agent")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, isActive, expiresAt], map: "ix_refresh_token_user_active")
  @@map("refresh_token")
}
