// Prisma is the only source of truth for the schema. Every change goes through a
// migration; `prisma migrate deploy` runs on the server, never `db push`.
//
// Conventions for every table added from here on:
//   id uuid default gen_random_uuid(), created_at/updated_at timestamptz,
//   is_active boolean default true, snake_case @map names, onDelete: Restrict
//   (rows are soft-deactivated, never deleted or cascaded away).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Configurable business constants. Statuses, roles and types live here rather than in
/// TypeScript enums, so Ops can add or retire a value without a code change.
model LkpType {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @map("code")
  description String?  @map("description")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  values LkpValue[]

  @@unique([code], map: "uk_lkp_type_code")
  @@map("lkp_type")
}

model LkpValue {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  typeId   String  @map("type_id") @db.Uuid
  code     String  @map("code")
  label    String  @map("label")
  position Int     @default(0) @map("position")
  isActive Boolean @default(true) @map("is_active")

  /// Identity-style reference rows stay reserved once used: deactivating a status must
  /// not free its code for a different meaning, because existing rows still point at it.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  type LkpType @relation(fields: [typeId], references: [id], onDelete: Restrict)

  /// Reverse relations for the two ways a user points at a reference row.
  usersAsRole   User[] @relation("user_role")
  usersAsStatus User[] @relation("user_status")

  /// Profiles that offer this subject, once `Subject` rows exist.
  teacherSubjects TeacherSubject[] @relation("subject_profile")

  /// Courses at this level, and courses in this stage of their life.
  coursesAsLevel  Course[] @relation("course_level")
  coursesAsStatus Course[] @relation("course_status")

  /// What a course price is quoted in.
  coursesAsPrice Course[] @relation("course_price_currency")

  /// Lessons in their own stage of being written.
  lessonsAsStatus Lesson[] @relation("lesson_status")

  /// Bookings of each kind — an enrolled class, a demo call.
  bookingsAsType Booking[] @relation("booking_type")

  /// Bookings in each stage of their life.
  bookingsAsStatus Booking[] @relation("booking_status")

  /// Coupons that apply this kind of discount (percentage or fixed).
  couponsAsDiscountType Coupon[] @relation("coupon_discount_type")

  /// The names marked this way at a class — present, absent.
  classAttendanceAsStatus ClassAttendance[] @relation("class_attendance_status")

  /// Payments quoted in this currency.
  paymentsAsCurrency Payment[] @relation("payment_currency")

  /// Payments in this stage of their lifecycle.
  paymentsAsStatus Payment[] @relation("payment_status")

  @@unique([typeId, code], map: "uk_lkp_value_type_code")
  @@index([typeId, isActive, position], map: "ix_lkp_value_type_active")
  @@map("lkp_value")
}

/// Anyone who can sign in to one of the three portals. The role is a lookup row, not a
/// column of allowed strings, so Ops can retire a role without a migration.
model User {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Stored lower-case by the service that writes it. Unique forever: deactivating an
  /// account must not recycle its address, or a new owner would inherit the old one's
  /// bookings, payouts and reviews.
  email           String    @unique @map("email")
  passwordHash    String    @map("password_hash")
  fullName        String    @map("full_name")
  /// IANA zone the user works in ("Asia/Kolkata"), never a fixed UTC offset — a DST change
  /// has to move the instant, which is what "same class time" means to a teacher.
  timezone        String    @default("UTC") @map("timezone")
  roleValueId     String    @map("role_value_id") @db.Uuid
  statusValueId   String    @map("status_value_id") @db.Uuid
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(6)

  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  role          LkpValue        @relation("user_role", fields: [roleValueId], references: [id], onDelete: Restrict)
  status        LkpValue        @relation("user_status", fields: [statusValueId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]
  profile       TeacherProfile?
  courses       Course[]        @relation("course_teacher")
  /// The courses this person holds a place in. Named `enrollments` rather than `courses`
  /// because a teacher's own list is already `courses`, and the two must not rhyme.
  enrollments   Enrollment[]    @relation("enrollment_student")

  /// The weekly windows a teacher keeps open for booking. Owned by the account the way a
  /// course is: a teacher is archived, never deleted, so a past booking still names the
  /// window that made it possible.
  availabilityRules AvailabilityRule[] @relation("teacher_availability")

  /// The classes this person booked. A student's own calendar, and the row a cancellation
  /// stays on so the class list can show what was called off.
  bookingsAsStudent Booking[] @relation("booking_student")

  /// The classes booked on this person's calendar, whichever of their courses they came from.
  /// A teacher's pool is one pool, so the claim is keyed on the account and not on a course.
  bookingsAsTeacher Booking[] @relation("booking_teacher")

  /// The notifications addressed to this account. Not the address they were sent to: the sweep
  /// reads `email` when it sends, so a correction to the account is honoured by a letter that was
  /// already queued.
  mailOutbox MailOutbox[] @relation("mail_outbox_recipient")

  /// The actions this account took. Kept alive by the same restriction as everything else that
  /// records what happened to whom: a person with a record of their decisions cannot be deleted out
  /// from under it, and a log whose actor resolves to nobody no longer answers "who".
  actions ActionLog[] @relation("action_log_actor")

  /// The days this teacher does not teach — holidays, festivals, personal days off.
  holidays Holiday[]

  /// The dated classes this person teaches, across every course — which is what a week of
  /// a calendar is.
  classOccurrencesTaught ClassOccurrence[] @relation("teacher_class_occurrences")

  /// The registers naming this person at a class, every week of every course they have joined.
  classAttendance ClassAttendance[] @relation("student_class_attendance")

  @@index([roleValueId, isActive], map: "ix_user_role_active")
  @@map("users")
}

/// What a student sees before they book: the teacher's own description of their work.
/// One row per teacher, written by the first save rather than at registration, so signing
/// up never leaves an empty profile that looks like a filled one.
///
/// The working timezone is deliberately absent — it lives on `User`, because a teacher's
/// zone decides when their classes are, not only what their profile says.
model TeacherProfile {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  /// One line in a search result. Kept short by validation so the card does not wrap.
  headline String? @map("headline")
  bio      String? @map("bio")

  /// Minor units plus an ISO 4217 code, never a float, and never a formatted string —
  /// "₹1,200" is unrenderable in a currency the reader does not share.
  /// Nullable as a pair: a teacher who has not decided yet should not be forced to
  /// publish a number they will not honour.
  hourlyRateMinorUnits Int?    @map("hourly_rate_minor_units")
  currencyCode         String? @map("currency_code") @db.VarChar(3)

  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  subjects TeacherSubject[]

  @@map("teacher_profile")
}

/// Which subjects a profile offers. A join row rather than an array column, because a
/// subject is a lookup value students will search and filter by, and a text array cannot
/// be indexed against a `lkp_value` that Ops may retire.
///
/// Removing a subject deactivates the row and re-adding it revives the same one — which is
/// what makes the unique key below safe alongside the no-hard-delete rule.
model TeacherSubject {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId      String @map("profile_id") @db.Uuid
  subjectValueId String @map("subject_value_id") @db.Uuid

  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile TeacherProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  subject LkpValue       @relation("subject_profile", fields: [subjectValueId], references: [id], onDelete: Restrict)

  @@unique([profileId, subjectValueId], map: "uk_teacher_subject")
  @@index([subjectValueId, isActive], map: "ix_teacher_subject_subject")
  @@map("teacher_subject")
}

/// A course a teacher is writing, has written, or has retired. Owned by exactly one
/// account: a co-author model would need a second table and the permissions question that
/// comes with it, and a marketplace where a course can change hands underneath a student
/// is a course nobody can be accountable for.
model Course {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherUserId String @map("teacher_user_id") @db.Uuid

  title String @map("title")
  /// The address a student is sent to. Unique per teacher rather than globally, because
  /// "intro-to-algebra" is a phrase two teachers will both reach for, and a global key
  /// hands the second one a fight over a word.
  ///
  /// Reserved for the teacher who used it first, even after the course is archived: an
  /// old link has to keep resolving to the thing it described.
  slug  String @map("slug")

  /// One line under a card title. Nullable, because a draft with no summary is still a
  /// draft worth keeping — but publishing is refused until it has one.
  summary     String? @map("summary")
  description String? @map("description")

  /// Level and status are lookup rows, so Ops can add a tier or retire a state without a
  /// migration; the transitions between statuses are enforced in code, which is the only
  /// place the difference between "archived" and "published" is meaningful.
  levelValueId  String @map("level_value_id") @db.Uuid
  statusValueId String @map("status_value_id") @db.Uuid

  /// What a place costs, in the integer minor units `packages/shared` moves money in, beside
  /// the currency row it is quoted against. Both halves are absent together, because "not
  /// priced yet" and "priced at nothing" are two different things a student is told.
  ///
  /// This is a quote on a shelf, not a charge: nothing collects a payment in this phase, and
  /// an enrollment stays a place rather than a purchase.
  priceMinorUnits      Int?    @map("price_minor_units")
  priceCurrencyValueId String? @map("price_currency_value_id") @db.Uuid

  /// Whether a student who has not enrolled may book a one-off demo call for this course. An
  /// opt-in the teacher grants, not a service the platform assumes: a column defaulting to true
  /// would open every published course's calendar to strangers on the day this migration ran.
  ///
  /// The cap that goes with it — one demo ever per student per course, and only for students not
  /// already enrolled — is a query the booking endpoint takes over surviving rows, not a key on
  /// either table. The numbers are business rules; the rows are history.
  demoBookingsEnabled Boolean @default(false) @map("demo_bookings_enabled")

  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  teacher User     @relation("course_teacher", fields: [teacherUserId], references: [id], onDelete: Restrict)
  level   LkpValue @relation("course_level", fields: [levelValueId], references: [id], onDelete: Restrict)
  status  LkpValue @relation("course_status", fields: [statusValueId], references: [id], onDelete: Restrict)

  /// The money a price names. `Restrict` for the reason a level is restricted: a retired
  /// currency must not orphan the quote a teacher wrote against it.
  priceCurrency LkpValue? @relation("course_price_currency", fields: [priceCurrencyValueId], references: [id], onDelete: Restrict)

  /// The syllabus, in the order the teacher put it in.
  modules Module[] @relation("course_modules")

  /// Who holds a place in this course. A roster is read from here, never from a count
  /// copied onto the course row, because the two would disagree the moment somebody left.
  enrollments Enrollment[] @relation("course_enrollments")

  /// The classes booked out of this course's schedule, by enrolled students and by demos.
  bookings Booking[] @relation("course_bookings")

  /// The recurring weekly series of classes for this course.
  classSeries ClassSeries[]

  /// The dated classes this course's series have opened, and the cohort each one expects.
  classOccurrences ClassOccurrence[] @relation("course_class_occurrences")

  /// The discount codes a teacher issued for this course.
  coupons Coupon[]

  @@unique([teacherUserId, slug], map: "uk_course_teacher_slug")
  @@index([teacherUserId, isActive, createdAt], map: "ix_course_teacher_created")
  @@map("course")
}

/// One ordered block of a course's syllabus — the level a lesson sits under.
///
/// A module has no status of its own: the course's lifecycle is what decides whether a
/// student can read this row, and a second flag would need rules for which one wins.
model Module {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId String @map("course_id") @db.Uuid

  title       String  @map("title")
  summary     String? @map("summary")
  description String? @map("description")

  /// The slot inside the course, assigned by the service and never by a client. Gaps are
  /// normal and kept: a retired module still holds its number, so nothing can slide into a
  /// slot a student's note, screenshot or bookmark once named.
  position Int @map("position")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  course Course @relation("course_modules", fields: [courseId], references: [id], onDelete: Restrict)

  /// The lessons inside this block, in the order the teacher put them in.
  lessons Lesson[] @relation("module_lessons")

  @@unique([courseId, position], map: "uk_module_course_position")
  @@index([courseId, isActive, position], map: "ix_module_course_order")
  @@map("module")
}

/// One page of a module: what a teacher wrote, in the order it is taught.
///
/// Unlike a module, a lesson does carry its own status — a teacher writes a page over
/// several sittings, and a half-written one should not reach a student just because the
/// course around it is live. Both flags have to agree before a lesson is readable: the
/// course is the outer gate, the lesson the inner one, so neither exposes the other's
/// unfinished work.
model Lesson {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId String @map("module_id") @db.Uuid

  title String  @map("title")
  /// The page itself, as the teacher typed it. Nullable for the same reason a course's
  /// description is: naming a lesson is a planning act, and the writing can come after.
  body  String? @map("body")

  /// What the teacher thinks the page costs a student, shown but never enforced — it is an
  /// estimate, and an estimate a scheduling rule depended on would be a promise nobody made.
  estimatedMinutes Int? @map("estimated_minutes")

  /// The teacher's own "read this one without enrolling". It is a flag on one row and it
  /// opens nothing by itself: the catalog still requires the course to be published and this
  /// lesson to be published, so marking a draft free is a plan, not a leak. Default false
  /// because the alternative would publish every lesson ever written the moment it shipped.
  isFreePreview Boolean @default(false) @map("is_free_preview")

  /// The slot inside the module, assigned by the service and never by a client. Gaps are
  /// normal and kept: a retired lesson still holds its number, so nothing can slide into a
  /// slot a student's note or bookmark once named.
  position Int @map("position")

  /// A lookup row, so Ops can retire a stage without a migration; the transitions between
  /// them are enforced in code, which is the only place the difference is meaningful.
  statusValueId String @map("status_value_id") @db.Uuid

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  module Module   @relation("module_lessons", fields: [moduleId], references: [id], onDelete: Restrict)
  status LkpValue @relation("lesson_status", fields: [statusValueId], references: [id], onDelete: Restrict)

  /// The recordings and files a teacher has attached to this page, newest standing until a
  /// replacement retires it.
  assets LessonAsset[] @relation("lesson_assets")

  @@unique([moduleId, position], map: "uk_lesson_module_position")
  @@index([moduleId, isActive, position], map: "ix_lesson_module_order")
  @@map("lesson")
}

/// A file a teacher attached to a lesson — a recording of the class, uploaded through the
/// storage port (ARCHITECTURE §6). This row is the only thing that names the bytes: the file
/// itself sits in a directory nobody can guess a path into, and every read of it goes through
/// a route that asks who is asking first.
///
/// One lesson stands one asset at a time, and that is the endpoint's rule rather than a
/// constraint. A replacement retires the previous row instead of deleting it (§2), so the
/// retired row has to keep its `lessonId` — a unique pair would refuse exactly the history
/// that keeping it is for.
///
/// The asset has no status of its own, unlike its lesson. A lesson's status says whether a
/// student may read the page, which is a lifecycle a teacher moves through; an asset is one
/// yes-or-no about whether it is the standing file, and `isActive` already answers it. A
/// second flag would need the rules for which one wins that §9 refused for a module.
model LessonAsset {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId String @map("lesson_id") @db.Uuid

  /// What the teacher called the file, shown on their own page. Free text on purpose: two
  /// lessons of a course may both hold `intro.mp4`, and a name a person recognises is not a
  /// key.
  displayName String @map("display_name")

  /// The key the bytes were written under, minted by the endpoint rather than taken from the
  /// upload. Unique across every row including retired ones, because a retired asset still
  /// names bytes on disk — handing the same key to a second row would put two files' history
  /// behind one path.
  storedKey String @map("stored_key")

  /// The mime type the upload declared, recorded as sent. It is not a verdict: what a teacher
  /// may attach is the endpoint's decision, and a lookup row for every mime type would be a
  /// list Ops cannot maintain any better than the client that sent it.
  contentType String @map("content_type")
  /// Size in bytes, frozen at upload. Recomputing it from the disk at display time would let
  /// a lesson page's wording change under a student who was quoting it.
  bytes       Int    @map("bytes")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  lesson Lesson @relation("lesson_assets", fields: [lessonId], references: [id], onDelete: Restrict)

  @@unique([storedKey], map: "uk_lesson_asset_stored_key")
  @@index([lessonId, isActive], map: "ix_lesson_asset_lesson_active")
  @@map("lesson_asset")
}

/// A student's place in a course: the row that says they may read it.
///
/// One row per student per course, kept forever. Leaving sets `isActive` false rather than
/// deleting, for two reasons — the pages they worked through were opened by this
/// enrollment, so the record of their access has to outlive it; and a second insert for the
/// same pair would leave a roster holding two answers to the question "is this person in
/// this course". Coming back reopens the same row, which is also why `createdAt` is the
/// date they first enrolled and not the date they returned.
///
/// Whether a person *may* take a place is decided by the endpoint that writes one: the
/// course has to be published, the student has to not own it. Neither is a column here,
/// because both are rules Ops or a teacher can change, and a constraint would freeze them.
model Enrollment {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentUserId String @map("student_user_id") @db.Uuid
  courseId      String @map("course_id") @db.Uuid

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  student User   @relation("enrollment_student", fields: [studentUserId], references: [id], onDelete: Restrict)
  course  Course @relation("course_enrollments", fields: [courseId], references: [id], onDelete: Restrict)

  /// The payments made for this enrollment.
  payments Payment[]

  /// The pair, not the student: one place per course, and a second course is a second
  /// decision. Reserved after a leave, exactly as a slug is reserved after an archive.
  @@unique([courseId, studentUserId], map: "uk_enrollment_student_course")
  @@index([studentUserId, isActive, createdAt], map: "ix_enrollment_student_list")
  @@index([courseId, isActive], map: "ix_enrollment_course_roster")
  @@map("enrollment")
}

/// One weekly open window a teacher keeps for bookings, stored as a wall-clock range in
/// their declared IANA zone (ARCHITECTURE §5). A rule is a recurring plan, not an instant:
/// `startMinutes`/`endMinutes` are minutes from local midnight on `weekday`, and it is the
/// slot generator that walks them forward across the horizon and turns each occurrence into
/// a UTC instant. Storing a fixed UTC range instead would drift every class by an hour
/// twice a year, which is not what "I teach Monday mornings" means to a teacher.
///
/// Which weekday, whether the range is well-formed and whether two rules overlap are the
/// availability endpoint's decisions, not column constraints — the table only records that a
/// teacher asked for this slice of their week to exist, so the same reason `price` has no DB
/// CHECK applies here.
model AvailabilityRule {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherUserId String @map("teacher_user_id") @db.Uuid

  /// 1–7, Monday first, mirroring `Date#getUTCDay` shifted so Sunday is the last day a
  /// teacher would reasonably choose. An integer rather than a lookup because the seven days
  /// are not a business constant Ops can add an eighth to.
  weekday      Int @map("weekday")
  /// Wall-clock minutes from local midnight. Kept as `start < end`, in whole minutes, by the
  /// endpoint — see the model note on why no database CHECK.
  startMinutes Int @map("start_minutes")
  endMinutes   Int @map("end_minutes")
  /// The length of one bookable class inside this window, so the generator knows how to tile
  /// 09:00–12:00 into three 45-minute slots. Shown and scheduled by, never a suggestion.
  slotMinutes  Int @map("slot_minutes")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  teacher User @relation("teacher_availability", fields: [teacherUserId], references: [id], onDelete: Restrict)

  /// One window may open at a given minute on a given day. A second rule starting at the same
  /// minute would hand a student the same 09:00 class twice; a different start time is a
  /// different slice of the week and stands. Like every other business key here it is unique
  /// among all rows, so retiring a window and re-adding the same one reopens the row rather
  /// than creating a competing twin (§2).
  @@unique([teacherUserId, weekday, startMinutes], map: "uk_availability_rule_start")
  @@index([teacherUserId, isActive, weekday], map: "ix_availability_rule_teacher_week")
  @@map("availability_rule")
}

/// One class a student claimed on a teacher's calendar: the row that keeps a minute from being
/// taken twice.
///
/// The booking is the slot hold, so §5's race guard is a unique index rather than a second
/// table. `slotHeldAt` names the instant this row keeps occupied and is null for a row that
/// occupies nothing, and Postgres lets any number of rows share a null in a unique index — which
/// makes `@@unique([teacherUserId, slotHeldAt])` exactly "one standing class per teacher per
/// minute". The alternative was a partial index over the blocking statuses, and it is not
/// available twice over: Prisma cannot write a `WHERE` into an index, and an index predicate
/// could not read a status that is an `LkpValue` row (§3). So which statuses claim a minute is
/// decided by the booking service, from `BLOCKING_BOOKING_STATUSES`, and the index is what
/// separates the two writers that raced past each other's checks.
///
/// The teacher is a column and not only a join to `course`, because the pool is the teacher's
/// rather than the course's: a minute claimed for one course is unavailable for another, and an
/// index cannot reach through a relation. The service keeps the two agreeing on who owns the
/// course.
model Booking {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentUserId String @map("student_user_id") @db.Uuid
  teacherUserId String @map("teacher_user_id") @db.Uuid
  courseId      String @map("course_id") @db.Uuid

  /// Enrolled class or demo call, and pending or confirmed or cancelled. Both are lookup rows,
  /// so a new kind of trial or a new stage is an insert rather than a migration, and both are
  /// decided by the endpoint that writes them: nothing here knows what a status implies.
  typeValueId   String @map("type_value_id") @db.Uuid
  statusValueId String @map("status_value_id") @db.Uuid

  /// The start as a UTC instant, produced by expanding a wall-clock rule across the horizon in
  /// the teacher's zone (§5). Storing the instant is what makes a DST change move a class rather
  /// than mislabel it; the clock face a student reads is this, converted to the viewer's zone.
  startsAt        DateTime  @map("starts_at") @db.Timestamptz(6)
  /// The length booked, frozen here rather than read from the rule at display time: a class
  /// taken as forty-five minutes stays a forty-five-minute class after the teacher starts
  /// teaching an hour, so a student's past list cannot be redrawn by a schedule edit.
  durationMinutes Int       @map("duration_minutes")
  slotHeldAt      DateTime? @map("slot_held_at") @db.Timestamptz(6)

  /// The room this class is held in, as the video port names it (§6). Written when the teacher
  /// confirms — a request that is refused or left to expire never had a class — and never
  /// rewritten afterwards, because a booking row does not forget what happened to it.
  ///
  /// The name, not the address: where the bridge lives is configuration, and rows that stored a
  /// URL would have to be migrated the day a school moves to its own domain. Nothing here is
  /// encrypted, because it does not need to be and the difference is not subtle — this value is
  /// the only thing keeping a Jitsi room private, so it is a secret that happens to live in a
  /// column: read by the two accounts a gate has already accepted, and sent nowhere else.
  ///
  /// Unique, and nullable, because both halves are the promise: many classes have no room, and
  /// no two classes share one.
  roomName String? @unique @map("room_name")

  /// The row-level flag the convention requires. A cancelled class is not an archived row — it
  /// is a standing row in a cancelled status — and releasing a minute is `slotHeldAt` going null,
  /// which is why retirement clears the hold in the same write instead of leaving a row that
  /// blocks a calendar nobody is using.
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  student User @relation("booking_student", fields: [studentUserId], references: [id], onDelete: Restrict)
  teacher User @relation("booking_teacher", fields: [teacherUserId], references: [id], onDelete: Restrict)

  course Course   @relation("course_bookings", fields: [courseId], references: [id], onDelete: Restrict)
  type   LkpValue @relation("booking_type", fields: [typeValueId], references: [id], onDelete: Restrict)
  status LkpValue @relation("booking_status", fields: [statusValueId], references: [id], onDelete: Restrict)

  /// The claim, per teacher. A student may hold two minutes of one teacher's calendar — a term of
  /// weekly classes is exactly that — so the pair that cannot repeat is the teacher and the
  /// instant, never the student and the course. That is also why "one demo ever" is a count the
  /// service takes over surviving rows: a key here would freeze the cap at one forever, and the
  /// cap is a business number.
  @@unique([teacherUserId, slotHeldAt], map: "uk_booking_slot_hold")
  @@index([studentUserId, isActive, startsAt], map: "ix_booking_student_calendar")
  @@index([teacherUserId, isActive, startsAt], map: "ix_booking_teacher_calendar")
  @@index([courseId, isActive, startsAt], map: "ix_booking_course_schedule")
  @@map("booking")
}

/// One issued refresh session. The plaintext token never reaches the database — only its
/// digest — so a leaked table cannot be used to mint sessions.
model RefreshToken {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  tokenHash String    @unique @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Revocation is a business transition with a date, distinct from `isActive`, which
  /// means "this row is archived". Rotation writes a new row rather than editing this one.
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent String?   @map("user_agent")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, isActive, expiresAt], map: "ix_refresh_token_user_active")
  @@map("refresh_token")
}

/// The copy half of one notification.
///
/// Phase 6 split a message in two and this table holds one half: the words an operator may
/// reword without a deploy. The layout is not here — a row of HTML would be an unreviewed,
/// untested document that every mail client renders differently, and Outlook reads markup with
/// Word's engine, so the primitives in `modules/notifications` own the tables and inline styles
/// instead (§6). An `href` is not here either: where a button goes is decided by the code that
/// owns the thing the message is about, and a link an operator can point anywhere is a second
/// door around every page the portals authenticate.
///
/// `{slot}` names are the contract between the two halves. The copy asks for a value by name and
/// the caller supplies it; nothing here evaluates, branches or loops, so a row cannot ask for
/// something the renderer would have to work out.
///
/// `eventCode` is unique across every row rather than across the standing ones, which is the
/// identity half of the split this schema uses elsewhere: a code names a send decision in the
/// code, and two rows answering to one code would leave a caller unable to say which one a
/// reader received. A reword is therefore an update to the standing row, and the history of what
/// a message once said belongs to Phase 7's action log rather than to retired rows.
///
/// The renderer refuses a filled sentence whose slot the payload cannot answer, so a typo in
/// here shows up as a notification that was not written rather than as a reader being handed
/// "Your class is on {when}".
model EmailTemplate {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// The send decision this copy belongs to, from the list in `@lms/shared`. A lookup row would
  /// have been the convention, and it is the wrong one: nothing outside this codebase adds a
  /// value to it, and a value with no code that reaches it is a row that cannot be true.
  eventCode String @unique @map("event_code")

  /// The line a reader sees before opening anything. Kept as a column rather than built from the
  /// heading, because a mailbox lists them side by side and an operator needs both.
  subject String
  heading String

  /// The body, one sentence per element, in order. Postgres arrays keep that order without a
  /// position column a caller could write twice, and a list of sentences is what lets an operator
  /// reword the middle of a message without retyping the ends of it.
  bodyLines String[] @default([]) @map("body_lines")

  /// Null means this event sends no button — a notice, not a request. The label only: the
  /// destination it would lead to is the caller's, and a row holding both would be a row holding
  /// an address.
  ctaLabel String? @map("cta_label")

  /// A deactivated row means the event stopped being worth sending. The renderer is given the
  /// standing row by the caller, so this flag is read where the decision is made rather than
  /// assumed here.
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("email_template")
}

/// The decision to notify, written in the same transaction as the change it reports.
///
/// A row is the news rather than the letter: the event and the facts as they stood, which the
/// delivery sweep renders into a message when it goes to send it (§6). Rendering at the far end
/// rather than at the request is what makes a retry able to succeed at all — a reworded template,
/// or a payload with the sentence the row was missing, repairs a queued row instead of leaving it
/// wrong forever. It is also what keeps a notification from being able to break a booking: the
/// write inside the request is one insert, and every rule about what may be sent lives on the other
/// side of it.
///
/// The table holds no address, on purpose. `User.email` is read when the sweep sends, so a person
/// who corrected their address is not mailed at the old one, and a queue table stays out of the
/// business of copying personal data forward into a row that outlives the correction and the
/// deletion both. A log line about this row may name the recipient's id, which §6 allows.
///
/// `event_code` is a string rather than a foreign key into `email_template` for the same reason:
/// an FK would let a missing template row fail the transaction that was only trying to record a
/// place in a course. An event with no copy is a message the sweep refuses to render — it becomes
/// `failed` with the reason the renderer gave, and the class still happened.
///
/// `status` is a text column whose values live in `@lms/shared`, not a lookup type: a state whose
/// only writer is a scheduler is a step in a program, not reference data an operator maintains.
/// Which states follow which, and how many times a row may be tried, are the sweep's rules; no
/// constraint here knows what a status implies.
model MailOutbox {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Which send decision wrote this, and so which template row the sweep will render against.
  eventCode String @map("event_code")

  /// The answers to the copy's `{slot}` names, frozen at the moment the news happened. `jsonb`
  /// keeps no key order and nothing here is read by position; the payload is a set of named
  /// answers, which is exactly the contract between a send decision and a template.
  payload Json @default("{}")

  /// Who is to be told. Kept alive by the same restriction as every other record of what happened
  /// to an account: a person with a letter waiting cannot be deleted out from under it.
  recipientUserId String @map("recipient_user_id") @db.Uuid

  /// `queued` on write. The sweep's read is this column plus `nextAttemptAt`, which is why the
  /// pair is indexed together rather than either alone.
  status String @default("queued")

  /// How many times the transport was asked. Kept as a count rather than derived from timestamps
  /// because the retry budget is a number in `@lms/shared` that a reader must be able to compare
  /// against without reconstructing the sweep's history.
  attempts Int @default(0)

  /// When this row may next be tried. Not nullable, because `null` would have to mean both "never
  /// scheduled" and "never again"; a finished row keeps the last time it was due as a fact, and
  /// `status` is what says it is over.
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at") @db.Timestamptz(6)

  /// Set once by the transport's acceptance. `sentAt` rather than `updatedAt`, because a retry
  /// touching the row would otherwise move the date a person asks about.
  sentAt DateTime? @map("sent_at") @db.Timestamptz(6)

  /// The transport's error code from the last refusal (`EAUTH`, `smtp 550`) — never its message,
  /// which names the host and on an auth failure the login. The sanitising is 6a's adapter
  /// guarantee, so no shape rule belongs here; this column records what the port was willing to
  /// say.
  failureReason String? @map("failure_reason")

  /// The row-level flag the convention requires. Nothing in Phase 6 writes it false: a delivered,
  /// failed or dropped row is a standing row in a terminal status, which is a fact about what
  /// happened rather than an archive. It is here for the day an operator retires a mistaken burst
  /// of a thousand rows without deleting the record that they were queued.
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  recipient User @relation("mail_outbox_recipient", fields: [recipientUserId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt], map: "ix_mail_outbox_due")
  /// "What has this person's news done" — the queue screen's second question, and the one the due
  /// index cannot answer, since a recipient is not a prefix of it. `createdAt` is the second column
  /// because that is the order the read answers in, newest letter first.
  @@index([recipientUserId, createdAt], map: "ix_mail_outbox_recipient")
  @@map("mail_outbox")
}

/// The record of a decision: who took it, which row it landed on, and which part of the app it was
/// taken in. Written inside the same transaction as the change it describes, and never edited
/// afterwards.
///
/// This is a ledger rather than a table with a state. §2 asks major tables for `isActive` and
/// `updatedAt` and excludes them from ledgers, and this is the table that finds out what that costs:
/// a column saying when a row was edited is an invitation to edit a row that records what somebody
/// else did, and a flag saying it was retired is a record that somebody decided to stop believing it.
/// A correction here is a second row, with the first staying as the record that it was believed.
/// `createdAt` is the only timestamp on it.
///
/// The four columns carrying vocabulary — `actionCode`, `sectionCode`, `actorKind`, `targetTable` —
/// are text rather than foreign keys or lookup rows, for the reason 6c gave for `event_code`: they
/// name lists only this codebase writes, an operator adding a value to one could only ever produce a
/// row no code is capable of recording, and a reference that could fail would let a bookkeeping
/// problem destroy the business write it was only there to record. The lists live in `@lms/shared`,
/// which the recorder reads before this table ever sees a value.
///
/// Nothing here is unique, which is the same property the queue has: the same action legitimately
/// happens twice to one row, and a key that refused the second one would be a log saying something
/// untrue about the first. That a replay which changed nothing records nothing is the recorder's rule
/// about when this table is written to, not a constraint on what a row may hold.
model ActionLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// The decision this row records. Two rows with the same code are two times it happened.
  actionCode String @map("action_code")

  /// Which part of the app the action came from — a fact about the action rather than about the
  /// request, so a value a caller could fill in never becomes the answer to "where did this happen".
  sectionCode String @map("section_code")

  /// `user` or `system`. `system` is a scheduler's own work — today, one sweep letting an unanswered
  /// request go — and the column exists so a reader never has to infer it from an empty actor.
  actorKind String @map("actor_kind")

  /// Who took the decision. Null exactly when `actorKind` is `system`, which is a rule the recorder
  /// keeps rather than a CHECK, because Prisma drops a hand-written constraint the next time it
  /// generates a migration for anything else.
  ///
  /// A person's id and never their email, for the reason the queue holds no address: this row outlives
  /// the correction they make to their account, and the deletion they ask for.
  actorUserId String? @map("actor_user_id") @db.Uuid

  /// The role as it stood when the action was taken. Their current role is readable from `users`;
  /// this answers a different question — what was this person allowed to do at the time — and a
  /// promotion must not rewrite what they did before it.
  actorRoleCode String? @map("actor_role_code")

  /// The table the action was about, named as `@@map` names it, so a reader of a log row goes
  /// straight to the table the words name. Paired with `targetId`, and no foreign key behind either.
  targetTable String @map("target_table")

  /// The row itself: a uuid with no promise that it still resolves, because the point of keeping the
  /// record is that a course archived next year was published in September.
  targetId String @map("target_id") @db.Uuid

  /// The decided facts: a status from one code to another, a price before and after, which way a
  /// switch went. Named answers, read by name — `jsonb` keeps no key order, so nothing may be read by
  /// position.
  ///
  /// Not a copy of the row the action touched: a snapshot carries personal data forward past both the
  /// correction and the deletion, and grows with every column the table gains. Nor a place for a
  /// secret — the room name a confirming teacher mints changes a booking and must not appear here, and
  /// that is the recorder's rule rather than a constraint this table could state, because to Postgres
  /// a room name is a string like any other.
  detail Json @default("{}")

  /// The request that caused this, which is what links a row to the access-log line of the same name.
  /// Null for a scheduler's write, which has no request to point back to.
  requestId String? @map("request_id")

  /// When the action happened. `now()` is a transaction's own clock rather than a statement's, so two
  /// rows written by one transaction carry the same instant — which is the honest answer, because the
  /// decisions behind them were taken as one.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation("action_log_actor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt], map: "ix_action_log_actor")
  @@index([sectionCode, createdAt], map: "ix_action_log_section")
  @@index([targetTable, targetId, createdAt], map: "ix_action_log_target")
  @@index([actionCode, createdAt], map: "ix_action_log_action")
  @@index([createdAt], map: "ix_action_log_recent")
  @@map("action_log")
}

/// A recurring series of classes a teacher schedules for a course, repeating weekly on the
/// chosen day. Each row is one slot in the teacher's week — Monday at 09:00–10:00, Thursday
/// at 14:00–15:00 — and it is a plan rather than a class: the dated rows it stands for are
/// `class_occurrence`, written by the generation sweep from the same arithmetic
/// (`expandSeries` in @lms/shared) that decides what a calendar offers.
///
/// The series has no status of its own: `isActive` answers whether it is still running, and
/// a retired series keeps its rows — and its dated classes — so past weeks still resolve which
/// plan made them possible. The timezone is absent because it lives on the teacher's account
/// (§5), and the day-of-week is stored as an integer matching `AvailabilityRule.weekday`.
model ClassSeries {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId        String @map("course_id") @db.Uuid
  weekday         Int    @map("weekday")
  startMinutes    Int    @map("start_minutes")
  endMinutes      Int    @map("end_minutes")
  durationMinutes Int    @map("duration_minutes")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  /// The classes this pattern has opened, and will keep opening while it runs.
  occurrences ClassOccurrence[]

  /// One series may run on a given day at a given time for one course. A second row with the
  /// same weekday and start would hand a student two bookings for the same minute; the unique
  /// key prevents that, and retiring a series reopens the slot rather than creating a twin.
  @@unique([courseId, weekday, startMinutes], map: "uk_class_series_course_slot")
  @@index([courseId, isActive, weekday], map: "ix_class_series_course_week")
  @@map("class_series")
}

/// A day a teacher does not teach: a public holiday, a personal day off, or a festival that
/// stops all classes. Stored as a date rather than an instant because the whole day is blocked,
/// and the zone decides when midnight is.
///
/// Recurring annually means this date is blocked every year (Diwali, Christmas, New Year), while
/// a one-off blocks only the stated year. The table is owned by the teacher's account because a
/// holiday is personal to them — one teacher's festival is another teacher's working day.
model Holiday {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherUserId     String  @map("teacher_user_id") @db.Uuid
  date              String  @map("date") @db.VarChar(10)
  reason            String? @map("reason")
  isRecurringAnnual Boolean @default(false) @map("is_recurring_annually")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  teacher User @relation(fields: [teacherUserId], references: [id], onDelete: Restrict)

  /// One holiday per teacher per date. A second entry for the same day would be redundant, and
  /// the unique key keeps the list clean. ISO 8601 dates sort lexicographically, which is why
  /// the column is text rather than date — the format is enforced by validation.
  @@unique([teacherUserId, date], map: "uk_holiday_teacher_date")
  @@index([teacherUserId, isActive], map: "ix_holiday_teacher_active")
  @@map("holiday")
}

/// One class a series actually opened on the calendar: the pattern with a date attached to it.
///
/// This is a separate aggregate because `booking` cannot hold it. That table's race guard is
/// `uk_booking_slot_hold` — one standing class per teacher per minute — which is exactly right
/// for a minute a student claims and exactly wrong for a class fifty students are expected at:
/// a cohort would need fifty rows sharing the teacher's minute, and the index would refuse every
/// one after the first. So the booked class and the assigned class are two things, named
/// differently, and each keeps the promise it was built for.
///
/// There is no status column. A generated occurrence is not a request waiting on an answer: the
/// pattern says the class happens, so it happens, and the two questions a reader asks of it — has
/// it gone by, and is it still on — are answered by `startsAt` and `isActive` rather than by a
/// code. A day off is a holiday, which means the row is never written; closing the plan itself is
/// retiring the series. Anything else would be a column nothing in the platform writes.
///
/// `durationMinutes` is copied from the series rather than joined, on the same reasoning as
/// `booking.duration_minutes`: a class that was on for an hour stays an hour after the teacher
/// starts teaching forty-five minutes, so the record of a past week cannot be redrawn by a later
/// edit to the plan.
model ClassOccurrence {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  seriesId      String @map("series_id") @db.Uuid
  courseId      String @map("course_id") @db.Uuid
  teacherUserId String @map("teacher_user_id") @db.Uuid

  /// The instant `expandSeries` produced for the pattern in the teacher's zone (§5), which is why
  /// a spring-forward week can simply not have a row for the face that never arrived.
  startsAt        DateTime @map("starts_at") @db.Timestamptz(6)
  durationMinutes Int      @map("duration_minutes")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  series  ClassSeries @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  course  Course      @relation("course_class_occurrences", fields: [courseId], references: [id], onDelete: Restrict)
  teacher User        @relation("teacher_class_occurrences", fields: [teacherUserId], references: [id], onDelete: Restrict)

  /// The sheet of who was expected. Written with the row, so a class always has its cohort even
  /// after the last student's place has closed.
  attendances ClassAttendance[]

  /// The pattern, per instant. The generation sweep runs on a clock, may overlap itself, and may
  /// be the second instance to reach a given minute, so this index — not a read-then-write — is
  /// what keeps a term from listing one class twice.
  @@unique([seriesId, startsAt], map: "uk_class_occurrence_series_instant")
  @@index([teacherUserId, isActive, startsAt], map: "ix_class_occurrence_teacher_calendar")
  @@index([courseId, isActive, startsAt], map: "ix_class_occurrence_course_calendar")
  @@map("class_occurrence")
}

/// One name expected at one class, and what the teacher later said about it.
///
/// The row is written when the occurrence is, not when the person walks in: a register that only
/// holds marks cannot answer "who was meant to be there", and that is the question a missed class
/// is asked about. An unmarked row is therefore the normal state rather than a gap.
///
/// Deliberately not keyed to `enrollment`. A place can close and reopen, and the answer to "was
/// this person expected on that Monday" is a fact about that day; pointing at the enrollment row
/// would let a leave taken in November reach back and un-answer a question about March.
model ClassAttendance {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurrenceId  String @map("occurrence_id") @db.Uuid
  studentUserId String @map("student_user_id") @db.Uuid

  /// Whether the person came, once a teacher has said. Null is not "absent" and not "pending": it
  /// is that nobody has marked the line yet, and no code stands for that better than the absence
  /// of one.
  statusValueId String? @map("status_value_id") @db.Uuid

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  occurrence ClassOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Restrict)
  student    User            @relation("student_class_attendance", fields: [studentUserId], references: [id], onDelete: Restrict)
  status     LkpValue?       @relation("class_attendance_status", fields: [statusValueId], references: [id], onDelete: Restrict)

  /// One line per person per class, so a mark twice made is one line written twice rather than a
  /// second answer to the same question.
  @@unique([occurrenceId, studentUserId], map: "uk_class_attendance_person_class")
  @@index([studentUserId, isActive], map: "ix_class_attendance_student")
  @@index([statusValueId], map: "ix_class_attendance_status")
  @@map("class_attendance")
}

/// A discount code a teacher issues for one of their courses. Each coupon carries its own
/// discount amount (percentage or fixed), validity window, and usage cap. Redeemed at
/// enrollment time, not stored on the enrollment row itself — a payment record links the two.
///
/// The code is unique per course, so two teachers may both use "WELCOME20" but one teacher
/// cannot reuse a code on the same course. Deactivation (`isActive = false`) stops redemptions
/// without deleting history.
model Coupon {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId String @map("course_id") @db.Uuid
  code     String @map("code")

  /// What kind of discount this coupon applies. Lookup row so Ops can add "buy-one-get-one"
  /// or other schemes without a migration.
  discountTypeValueId String @map("discount_type_value_id") @db.Uuid

  /// The discount amount. For percentage discounts, this is an integer 0–100. For fixed-amount
  /// discounts, this is in minor units (same as `priceMinorUnits` on Course).
  discountAmount Int @map("discount_amount")

  /// When the coupon becomes valid. Nullable means "immediately upon creation".
  validFrom DateTime? @map("valid_from") @db.Timestamptz(6)

  /// When the coupon expires. Nullable means "never expires" (subject to usage limits).
  validUntil DateTime? @map("valid_until") @db.Timestamptz(6)

  /// Maximum number of times this coupon can be redeemed across all students. Null means unlimited.
  maxRedemptions Int? @map("max_redemptions")

  /// How many times this coupon has been redeemed. Maintained by the enrollment endpoint, not
  /// by a trigger, because the redemption happens inside a transaction that also creates the
  /// enrollment and payment rows.
  redemptionCount Int @default(0) @map("redemption_count")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  course       Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  discountType LkpValue @relation("coupon_discount_type", fields: [discountTypeValueId], references: [id], onDelete: Restrict)

  /// The payments that used this coupon.
  payments Payment[]

  /// One active coupon code per course. A retired code may share its name with a new one, but
  /// two live coupons cannot fight over the same string on the same course.
  @@unique([courseId, code], map: "uk_coupon_course_code")
  @@index([courseId, isActive], map: "ix_coupon_course_active")
  @@map("coupon")
}

/// A payment attempt tied to an enrollment. Append-only ledger: each enrollment may have
/// multiple payment rows if retries occur, but only one reaches `completed`. The payment
/// provider stays behind a port (`PAYMENT_PROVIDER`), so this table records what happened
/// regardless of which vendor processed it.
///
/// No hard deletes: a failed payment is still part of the financial record, and a refund is
/// a new row pointing at the original.
model Payment {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enrollmentId String  @map("enrollment_id") @db.Uuid
  couponId     String? @map("coupon_id") @db.Uuid

  /// The amount charged, in minor units. Equals the course price minus any coupon discount.
  amountMinorUnits Int @map("amount_minor_units")

  /// The currency the amount is quoted in. Must match the course's price currency.
  currencyValueId String @map("currency_value_id") @db.Uuid

  /// Where the payment stands. Lookup row so Ops can add "refunded", "disputed", etc.
  statusValueId String @map("status_value_id") @db.Uuid

  /// The external reference from the payment provider (e.g., Stripe charge ID). Nullable for
  /// mock payments or before the provider responds.
  providerReference String? @map("provider_reference")

  /// Any error message from the provider. Kept separate from the status so a retry can clear
  /// the error while keeping the history.
  providerError String? @map("provider_error")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  coupon     Coupon?    @relation(fields: [couponId], references: [id], onDelete: Restrict)
  currency   LkpValue   @relation("payment_currency", fields: [currencyValueId], references: [id], onDelete: Restrict)
  status     LkpValue   @relation("payment_status", fields: [statusValueId], references: [id], onDelete: Restrict)

  /// One payment per enrollment per attempt. Multiple attempts are allowed for retries, but
  /// only one should reach `completed`. Enforced in code, not by a unique constraint.
  @@index([enrollmentId, createdAt], map: "ix_payment_enrollment")
  @@index([statusValueId, createdAt], map: "ix_payment_status")
  @@map("payment")
}
