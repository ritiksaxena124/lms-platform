{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    // The email primitives are React components server-rendered inside this process (Phase 6b),
    // so JSX compiles the way the portals' does: no `React` import in every file, and the runtime
    // is only ever reached during a render, never shipped to a mail client.
    "jsx": "react-jsx",
    "outDir": "dist",
    "baseUrl": ".",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "incremental": true,
    "declaration": false,
    "sourceMap": true,
    "removeComments": true,
    "allowJs": false,
    "types": ["node"],
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src", "test", "vitest.config.ts"],
  "exclude": ["dist", "node_modules"]
}
