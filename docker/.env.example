# Copy to docker/.env.docker and fill in the two blanks. `docker/.env.docker` is the real one and is
# git-ignored with every other .env file — the two values below are the only ones a container needs
# that do not exist in apps/api/.env on a laptop.
#
# Generate the secret, never type one:
#   openssl rand -hex 32

# Where the browser is sent to reach the API. It has to be the gateway's address, because it is also
# the origin that appears in the API's CORS allowlist (compose sets both from this one value).
API_PUBLIC_URL=http://api.localtest.me

POSTGRES_USER=lms
POSTGRES_DB=lms
# Local containers only; nothing in this stack is reachable from outside the machine.
POSTGRES_PASSWORD=lms

# Required by the API, with no code-level default on purpose — a per-process fallback would log every
# portal out on the next restart, and the boot fails loudly instead (apps/api/src/config/env.ts).
JWT_SECRET=

# Leave SMTP_URL empty and the stack sends no mail: notifications are dropped, the drop is logged by
# its event code, and no address is written with it. Set it to an smtps:// endpoint to try delivery.
SMTP_URL=
MAIL_FROM="Hourloom <no-reply@localtest.me>"

VIDEO_PROVIDER=jitsi
JITSI_DOMAIN=meet.jit.si
STORAGE_PROVIDER=local
MAX_UPLOAD_MB=15
PAYMENT_PROVIDER=none
REFRESH_TOKEN_TTL_DAYS=7
NODE_ENV=production
