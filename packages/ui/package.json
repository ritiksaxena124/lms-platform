{
  "name": "@lms/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Hourloom's design tokens, primitives and motion, shared by the teacher, student and ops portals and the public site.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css"
  },
  "scripts": {
